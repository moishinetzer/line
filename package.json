{
  "name": "group-dots",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"npm run dev -w @group-dots/server\" \"npm run dev -w @group-dots/web\"",
    "dev:rehearsal": "AGENT_MODE=astra LOVABLE_MODE=mock npm run dev",
    "dev:server": "npm run dev -w @group-dots/server",
    "dev:web": "npm run dev -w @group-dots/web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test apps/server/test/*.test.ts apps/web/src/lib/*.test.ts tools/lovable/server/*.test.ts",
    "build": "npm run typecheck && npm run build -w @group-dots/web",
    "lovable": "tsx tools/lovable/scripts/lovable.ts"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0"
  }
}
