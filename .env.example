# No credentials needed in mock mode. Set the two modes independently.
AGENT_MODE=mock
LOVABLE_MODE=mock
HOST=127.0.0.1
PORT=3001

# Astra: set AGENT_MODE=astra and add your hackathon API key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_BASE_URL=https://api.openai.com/v1

# Lovable: set LOVABLE_MODE=mcp, then visit /auth/lovable on the server.
LOVABLE_MCP_URL=https://mcp.lovable.dev
LOVABLE_WORKSPACE_ID=
# Optional: pre-created demo sites, used only by the mock Lovable adapter.
DEMO_PARTY_URL=https://saturday-sorted-app.lovable.app
DEMO_WAKEUP_URL=https://lines-rise-together.lovable.app
DEMO_BOBA_URL=https://the-usual-by-lines.lovable.app

# Frontend can override its server address; root .env is loaded by Vite.
VITE_WS_URL=ws://localhost:3001/ws

# Optional frontend-only simulated demo; normally leave false.
VITE_DEMO_MODE=false
